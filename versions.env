# The only place where versions are pinned. Scripts and manifests read this file;
# nothing else in this repository contains a version number of these components.
#
# Rule: install = current release minus one, so that the upgrade lab has a real
# step to take. Re-check these when Strimzi, Kafka or k3s publish a new release.

# The three install versions can be overridden from the environment (the upgrade lab does:
#   STRIMZI_VERSION=1.2.0 KAFKA_VERSION=4.3.1 ./cluster/prepare.sh).
# --- Installed in the labs -------------------------------------------------
# Strimzi 1.2.0 is the current release (2026-08-20); 1.1.0 is the only 1.1.x.
STRIMZI_VERSION=${STRIMZI_VERSION:-1.1.0}
# Newest Kafka that Strimzi 1.1.0 supports (its default). 1.2.0 supports 4.3.1.
KAFKA_VERSION=${KAFKA_VERSION:-4.3.0}
KAFKA_METADATA_VERSION=${KAFKA_METADATA_VERSION:-4.3-IV0}
# k3s: second-newest minor (v1.37 is the newest), latest patch of it.
K3S_VERSION=v1.36.5+k3s1

# --- Upgrade target (the upgrade lab) --------------------------------------
STRIMZI_UPGRADE_VERSION=1.2.0
KAFKA_UPGRADE_VERSION=4.3.1
KAFKA_UPGRADE_METADATA_VERSION=4.3-IV0

# --- Integrity of the downloaded Strimzi install files (sha256) ------------
STRIMZI_INSTALL_SHA256_1_1_0=ee7e38d61452fb7b3be08a3b0fb4497ee0e38d50eb38f41fa4c2276078f68fd0
STRIMZI_INSTALL_SHA256_1_2_0=a0b1ae3e375a7da0674eb3894df8aa955bc50abe8190bc9344e30b83bbee4775

# --- Monitoring and tools --------------------------------------------------
PROMETHEUS_VERSION=v3.15.0
GRAFANA_VERSION=13.2.3
KAFKA_UI_VERSION=v1.5.0
# kube-state-metrics: pod restarts, failed jobs (alerts of the monitoring lab). v2.20.0 is the current release.
KUBE_STATE_METRICS_VERSION=v2.19.0

# --- Fixed names -----------------------------------------------------------
KAFKA_NAMESPACE=kafka
KAFKA_CLUSTER=my-cluster
